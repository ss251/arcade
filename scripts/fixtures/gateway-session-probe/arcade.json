  "outputSchema": {
    "type": "object", "additionalProperties": false, "required": ["index", "proof"],
    "properties": {
      "index": { "type": "integer", "minimum": 1, "maximum": 20 },
      "proof": { "const": "offline-runner-probe" }
    }
  },
  "engine": { "adapter": "script", "credential": "none", "entry": "run.ts", "capabilities": [] },
  "secrets": [],
  "egress": []
}
