# Internal only — research, competitive analysis, build decisions, run state.
# Never published.
internal/

# Secrets
.env
.env.*
!.env.example
*.pem
*-recovery-file.json
throwaway-keys.json

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
.next/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Local caches
.cache/
.turbo/
lib/
contracts/out/
cache/

# Sandbox litter. `HOME` is redirected to the skill's own directory so a job cannot read
# the seller's home by relative path (packages/runner/src/exec.ts), which means anything a
# job runs writes its dotfiles and caches THERE. Regenerable, and it must never be
# committed alongside a skill.
skills/*/Library/
skills/*/.cache/
skills/*/.bun/
skills/*/.npm/
skills/*/.config/
