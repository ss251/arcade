{
  "name": "arcade",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --build --force && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "hub": "bun run --cwd apps/hub start",
    "web": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "arcade": "bun run packages/runner/src/cli.ts",
    "arcade-buy": "bun run packages/buyer/src/cli.ts",
    "arcade-mcp": "bun run packages/buyer/src/mcp.ts"
  },
  "devDependencies": {
    "@circle-fin/x402-batching": "^3.2.0",
    "@effect/vitest": "^0.30.0",
    "@types/bun": "latest",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.0",
    "viem": "^2.55.8",
    "vitest": "^3.2.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0"
  }
}
