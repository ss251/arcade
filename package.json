{
  "name": "arcade",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "hub": "bun run --cwd apps/hub start",
    "arcade": "bun run packages/runner/src/cli.ts",
    "arcade-buy": "bun run packages/buyer/src/cli.ts"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@types/bun": "latest",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
