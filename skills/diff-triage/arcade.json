{
  "id": "diff-triage",
  "version": "0.1.0",
  "serviceName": "Diff Triage",
  "description": "Structured triage of a code diff: what it changes, what could break, which tests are missing, and whether it is safe to merge. Pay per diff \u2014 no seat, no per-user licence.",
  "tags": [
    "code-review",
    "ci",
    "quality"
  ],
  "price": "$0.12",
  "replaces": "$30/user/mo code-review seat",
  "bounds": {
    "maxTurns": 4,
    "maxCostUsd": 0.07,
    "timeoutSec": 120
  },
  "inputSchema": {
    "type": "object",
    "required": [
      "diff"
    ],
    "properties": {
      "diff": {
        "type": "string",
        "description": "Unified diff to triage"
      },
      "context": {
        "type": "string",
        "description": "Optional context: what the change is meant to do"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "summary",
      "risk",
      "findings",
      "testGaps",
      "verdict"
    ],
    "properties": {
      "summary": {
        "type": "string",
        "description": "What this diff actually changes, in two or three sentences"
      },
      "risk": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "severity",
            "claim",
            "where"
          ],
          "properties": {
            "severity": {
              "type": "string",
              "enum": [
                "blocker",
                "major",
                "minor",
                "nit"
              ]
            },
            "claim": {
              "type": "string"
            },
            "where": {
              "type": "string",
              "description": "file:line or hunk header"
            }
          }
        }
      },
      "testGaps": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Behaviour this diff changes that nothing appears to cover"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "ship",
          "ship-with-nits",
          "needs-work",
          "do-not-merge"
        ]
      }
    }
  },
  "engine": {
    "adapter": "claude-agent",
    "credential": "api-key",
    "entry": "agent.ts",
    "capabilities": []
  },
  "secrets": [
    "ANTHROPIC_API_KEY"
  ],
  "egress": [
    "api.anthropic.com"
  ]
}
