{
  "extends": "../../tsconfig.base.json",
  // `server.ts` is the production entry and was previously excluded, because it imports the
  // Vite build output which does not exist on a clean checkout — leaving the one file that
  // actually runs in production as the one file nothing typechecked. `types/` declares that
  // module so it can be included without a build.
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/**/*.d.ts", "server.ts", "vite.config.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // The hub is a Bun program and types against `bun`. This is a browser+Node bundle, and
    // pulling Bun's globals in here would let a `Bun.*` call typecheck in code that ships to
    // a Vite build where it does not exist.
    "types": ["vite/client", "node"],
    "paths": {
      "@arcade/core": ["../../packages/core/src/index.ts"],
      "@arcade/core/*": ["../../packages/core/src/*"],
      "~/*": ["./src/*"]
    }
  }
}
